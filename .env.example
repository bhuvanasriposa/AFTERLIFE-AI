# Copy this file to ".env" and fill in your key. NEVER commit the real ".env" file.
#
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Open-weight Gemma 4 model served through the Gemini API.
# Alternatives: gemma-4-31b-it (stronger, slower)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server settings (optional)
PORT=3000
# Use 0.0.0.0 only when deploying to a host that needs it.
HOST=127.0.0.1
# Per-visitor limit on analysis requests per minute (protects your free quota).
RATE_LIMIT_PER_MINUTE=12
